{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "task-management",
  "main": "worker/index.js",
  // nodejs_compat + 2025-04-01 以降の日付で process.env / Buffer が使える
  // （既存のパイプラインコードを書き換えずに流用するため）
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // true で全パスをWorker経由にする。/api/* だけだと、それ以外（/sw.js・SPAの
    // 各ルート等）はCloudflareの静的アセット配信層がWorkerを経由せず直接返して
    // しまい、worker/index.js の route() で設定している index.html・sw.js への
    // Cache-Control上書き（PWA更新検知に必須）が一度も実行されなかった不具合を
    // 修正するため変更（2026-07-21）。ハッシュ付きファイル名のJS/CSS/画像等は
    // route() 側で素通ししているため、Cloudflareの通常のアセットキャッシュが
    // そのまま効く（振る舞いは変えていない）。
    "run_worker_first": true
  },
  "triggers": {
    // 5分ごとに起動。実際の取得間隔は settings.fetch_interval_minutes でゲート
    "crons": ["*/5 * * * *"]
  },
  // ログイン試行回数の記録用（総当たり/辞書攻撃対策のレート制限。IPごとに一定回数の
  // 失敗でロックアウトする。handleLogin から env.LOGIN_ATTEMPTS として参照する）
  "kv_namespaces": [
    { "binding": "LOGIN_ATTEMPTS", "id": "34182593196e4bc08791fc1091a59f87" }
  ],
  "observability": {
    "enabled": true
  }
  // シークレット（SUPABASE_URL, SUPABASE_SERVICE_KEY, SESSION_SECRET,
  // ANTHROPIC_API_KEY, GMAIL_CLIENT_ID, GMAIL_CLIENT_SECRET, GMAIL_REFRESH_TOKEN,
  // VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT）は
  // `npx wrangler secret put <NAME>` または CI（deploy.yml）経由で設定する
}
