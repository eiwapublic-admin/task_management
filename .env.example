# フロントエンドはデータ面（tasks/settings/logs/usage）を anon キーで直接読み書きしない。
# すべて Worker の /api/* を JWT 認証つきで叩くため、VITE_SUPABASE_URL /
# VITE_SUPABASE_ANON_KEY のようなフロント公開値は不要。

# --- Worker（サーバーサイド）用: 絶対に公開しない ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJxxx...
SESSION_SECRET=change-me-to-a-random-long-string

# --- Phase 2: メール取得・AI分類（Worker で使用） ---
ANTHROPIC_API_KEY=sk-ant-xxx...
# 分類に使うモデル（未指定なら claude-haiku-4-5）
CLAUDE_MODEL=claude-haiku-4-5
GMAIL_CLIENT_ID=xxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-xxx
GMAIL_REFRESH_TOKEN=1//xxx
SHARED_GMAIL_ADDRESS=shared@example.com
